#!/usr/bin/env bash
# Run ranger in a container as root, on the current directory.
set -euo pipefail

IMAGE="nvidia/cuda:12.8.1-base-ubuntu24.04-sm"
WORKDIR="$(pwd)"

# Mount host volumes at identical paths so absolute symlinks (e.g. -> /storage3/...) resolve.
# Disk layout is per server: add a case for each new host.
case "$(hostname -s)" in
    p-ws-40) ROOTS=(/home /storage2 /storage3) ;;
    p-ws-44) ROOTS=(/home /storage /storage3 /data) ;;  # /home -> /storage/home
    *)       ROOTS=(/home) ;;
esac
MOUNTS=()
covered=0
for r in "${ROOTS[@]}"; do
    [ -d "$r" ] || continue
    MOUNTS+=(-v "$r:$r")
    case "$WORKDIR/" in "$r/"*) covered=1 ;; esac
done
[ "$covered" = 1 ] || MOUNTS+=(-v "$WORKDIR:$WORKDIR")

# Pick the first free container name: sm-ranger-root-0, sm-ranger-root-1, ...
BASE_NAME="sm-ranger-root"
i=0
NAME="${BASE_NAME}-${i}"
while docker ps -a --format '{{.Names}}' | grep -qx "$NAME"; do
    i=$((i + 1))
    NAME="${BASE_NAME}-${i}"
done

docker run --rm -it \
    --gpus all \
    "${MOUNTS[@]}" \
    -w "${WORKDIR}" \
    -e XDG_CONFIG_HOME="${HOME}/.config" \
    --name "${NAME}" \
    "${IMAGE}" \
    ranger "$@"
