# Tmux settings
# Attach to an existing session or start new session otherwise
# Guarded on an interactive shell with tmux available, so that a missing or
# broken tmux cannot lock us out of a login shell (~/.profile execs zsh).
if [[ -o interactive ]] && [[ -z $TMUX ]] && command -v tmux > /dev/null 2>&1; then
    tmux -2 attach || tmux -2 new-session
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
  git
  sudo
  tmux
  aliases
  extract
  docker
  docker-compose
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting
  conda-zsh-completion
)

# Oh-my-zsh completions settings
# FPATH must be extended before oh-my-zsh.sh, which runs compinit itself.
# Brew's prefix is derived from its path rather than `brew --prefix`, a fork.
(( $+commands[brew] )) && FPATH="${commands[brew]:h:h}/share/zsh/site-functions:${FPATH}"

# lmod exports FPATH with a group-writable ksh_funcs directory owned by another
# uid, which we cannot chmod. compinit refuses to complete from it and oh-my-zsh
# prints a banner about it on every start, so drop it. Nothing is lost: lmod
# defines `module` and `ml` as real zsh functions, and ksh_funcs holds only the
# ksh autoload stubs. Matching the exact path rather than $MODULESHOME/* keeps
# this off environment-modules, which keeps its _module completion one directory
# over in init/zsh-functions. No-op on machines without lmod.
[[ -n $MODULESHOME ]] && fpath=(${fpath:#${MODULESHOME%/}/init/ksh_funcs})

# Runs compinit internally, so do not call it again below: a second compinit
# re-dumps the completion cache and costs ~230ms per shell.
source $ZSH/oh-my-zsh.sh

###############################
# Common Environment Settings #
###############################

# Terminal color settings
# TERM is deliberately not set here: the terminal emulator and tmux each
# advertise their own, and overriding it breaks truecolor detection.

# Standard encoding settings
# LC_ALL is deliberately not set: it overrides every other LC_* variable,
# which would silently discard the LC_CTYPE setting below.
export LANG=en_US.UTF-8

# Japanese encoding settings
export LANG_JP=C.UTF-8
export LC_CTYPE=$LANG_JP

# Always list directory after cd
function chpwd() {ls -a}

# Prepend a directory to PATH, if it exists and is not already present.
# The membership test keeps PATH stable when this file is re-sourced.
function path_prepend() {
    [[ -d $1 ]] || return 0
    case ":$PATH:" in
        *":$1:"*) ;;
        *) export PATH="$1:$PATH" ;;
    esac
}

# PATH settings
# path_prepend puts each entry in front, so the last one wins: ~/.local/bin goes
# last because it holds the pinned nvim and the node/bun shims. Tools are put on
# PATH before anything below probes for them with `command -v`.
case $OSTYPE in
    darwin*) path_prepend "/opt/homebrew/opt/trash-cli/bin" ;;
esac

# Conda settings
# Activating the base environment shells out to Python and costs ~220ms per
# shell. Sourcing conda.sh (which defines the `conda` function) costs ~1ms, so
# do that eagerly and replay a cached copy of the activation instead. The cache
# is rebuilt whenever the conda installation changes; delete it to force a
# refresh: rm ${XDG_CACHE_HOME:-~/.cache}/conda-base-activate.zsh
function _conda_init() {
    local root
    for root in /opt/homebrew/anaconda3 ~/anaconda3 ~/miniconda3; do
        [[ -f $root/etc/profile.d/conda.sh ]] && break
        root=""
    done
    [[ -n $root ]] || return 0

    source "$root/etc/profile.d/conda.sh"

    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/conda-base-activate.zsh"
    # Rebuild when missing, stale, or malformed. A cache captured while base was
    # already active is a *reactivation* diff that omits CONDA_PREFIX, leaving
    # conda half-activated (CONDA_SHLVL=1, no CONDA_PREFIX) and crashing every
    # later `conda activate/deactivate`.
    if [[ ! -s $cache || $root/conda-meta/history -nt $cache ]] \
        || ! grep -q '^export CONDA_PREFIX=' "$cache"; then
        mkdir -p "${cache:h}"
        # Drop the PS1 assignment (powerlevel10k renders the environment from
        # CONDA_PROMPT_MODIFIER) and rewrite conda's absolute PATH snapshot into a
        # prepend, so the cache composes with whatever PATH we have. Force a fresh
        # level-0 activation (CONDA_SHLVL=0, prefix vars unset) so conda emits the
        # full activation — including CONDA_PREFIX — instead of a reactivation diff.
        env -u CONDA_PREFIX -u CONDA_DEFAULT_ENV -u CONDA_PROMPT_MODIFIER CONDA_SHLVL=0 \
            "$root/bin/conda" shell.zsh activate base 2> /dev/null \
            | grep -v '^PS1=' \
            | sed "s|^export PATH=.*|path_prepend '$root/condabin'; path_prepend '$root/bin'|" \
            > "$cache"
    fi
    source "$cache"
}
_conda_init
unset -f _conda_init

# Bun settings
if [[ -d ~/.bun ]]; then
    export BUN_INSTALL="$HOME/.bun"
    path_prepend "$BUN_INSTALL/bin"
    [[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"
fi

# Local bin
path_prepend "$HOME/.local/bin"

# Terminal settings
# This is for Gogh terminal color scheme specifically for Gnome terminal
case $OSTYPE in
    linux*)
        export TERMINAL=gnome-terminal
    ;;
esac

# eza comes from brew on macOS, conda base (no sudo) on servers.
if command -v eza > /dev/null 2>&1; then
    alias ls="eza"
    alias ll="eza -lhg"
    alias la="eza -alhg"
fi

# Bat settings
# Debian and Ubuntu ship bat as batcat, due to a name clash with another package
if ! command -v bat > /dev/null 2>&1 && command -v batcat > /dev/null 2>&1; then
    alias bat='batcat'
fi
export BAT_THEME="gruvbox-dark"

# Fzf settings
# Fzf adjust viewing
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export FZF_DEFAULT_OPTS='--height 40% --reverse --border'
export FZF_DEFAULT_COMMAND='find .'
# Fzf advance settings
# Resolve the preview tools once, so that a machine missing any of them still
# gets a working preview instead of a silent "command not found"
if command -v eza > /dev/null 2>&1; then
    fzf_tree='eza --tree --color=always'
elif command -v exa > /dev/null 2>&1; then
    fzf_tree='exa --tree --color=always'
else
    fzf_tree='ls -R'
fi
if command -v bat > /dev/null 2>&1; then
    fzf_pager='bat -n --color=always --line-range :500'
elif command -v batcat > /dev/null 2>&1; then
    fzf_pager='batcat -n --color=always --line-range :500'
else
    fzf_pager='head -n 500'
fi
show_file_or_dir_preview="if [ -d {} ]; then $fzf_tree {} | head -200; else $fzf_pager {}; fi"
export FZF_CTRL_T_OPTS="--preview '$show_file_or_dir_preview'"
export FZF_ALT_C_OPTS="--preview '$fzf_tree {} | head -200'"
unset fzf_tree fzf_pager

# Default editor settings
# ~/.local/bin/nvim comes first on both platforms: that is where the pinned
# neovim tarball lands (NEOVIM_VERSION in scripts/steps/shared.sh). It has to
# win, or $EDITOR silently opens a different nvim than the prompt does — a
# brew-installed 0.12 defeats the pin exactly that way. The rest are fallbacks
# for machines the installer has not touched, newest layout first.
for _editor in "$HOME/.local/bin/nvim" /opt/homebrew/bin/nvim \
               /opt/nvim-linux-x86_64/bin/nvim /usr/bin/nvim /usr/bin/vim; do
    if [[ -x $_editor ]]; then
        export EDITOR=$_editor
        break
    fi
done
unset _editor

# Nvm settings
# ~/.nvm on both platforms, including macOS, where nvm itself comes from brew:
# its nvm.sh is symlinked in here so that `brew upgrade nvm` cannot delete the
# installed node versions along with the keg. See step_nvm in
# scripts/steps/shared.sh.
if [[ -d ~/.nvm ]]; then
    export NVM_DIR="$HOME/.nvm"
fi
# Sourcing nvm.sh eagerly costs ~360ms, most of it nvm's auto-use of the
# nearest .nvmrc. Install stubs that load nvm for real on first use instead.
if [ -s "$NVM_DIR/nvm.sh" ]; then
    function _nvm_load() {
        unset -f nvm node npm npx _nvm_load > /dev/null 2>&1
        \. "$NVM_DIR/nvm.sh"
        [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    }
    function nvm()  { _nvm_load; nvm "$@"; }
    function node() { _nvm_load; node "$@"; }
    function npm()  { _nvm_load; npm "$@"; }
    function npx()  { _nvm_load; npx "$@"; }
fi

# Gvm settings (installed by step_gvm, which tells the installer not to edit
# this file)
[[ -s "$HOME/.gvm/scripts/gvm" ]] && source "$HOME/.gvm/scripts/gvm"

# Ssh-agent settings
# Reuse a single agent across shells via a cached env file (no orphan agents).
# macOS presets SSH_AUTH_SOCK via launchd, so this is a no-op there; it only
# starts an agent on Linux/headless.
function _ssh_agent_init() {
    [[ -n $SSH_AUTH_SOCK ]] && return 0
    local ssh_env="$HOME/.ssh/agent.env"
    [[ -r $ssh_env ]] && source "$ssh_env" > /dev/null
    ssh-add -l &> /dev/null                       # exit 2 == no agent reachable
    if [[ $? -eq 2 ]]; then
        mkdir -p "${ssh_env:h}"
        (umask 077; ssh-agent -s > "$ssh_env")
        source "$ssh_env" > /dev/null
    fi
}
_ssh_agent_init
unset -f _ssh_agent_init

# Pretty print all environment variables
alias pe='env -0 | sort -z | tr "\0" "\n"'
# Pretty print path environment variable
alias pp='echo "${PATH//:/$'\\n'}"'
# Watch alias
alias wa='watch --color '
# Apt update
alias aptu='sudo apt update'
# Apt upgrade
alias aptg='sudo apt upgrade'
# Apt install
alias apti='sudo apt install'
# Apt remove
alias aptr='sudo apt remove'
# Apt autoclean
alias aptc='sudo apt autoclean'
# Apt autoremove
alias apta='sudo apt autoremove'
# Apt show
alias apth='apt show'
# Apt search
alias apts='apt-cache search'
# Apt policy
alias aptp='apt-cache policy'

# Docker settings
# Docker show process status
alias dkp='docker ps -a'
# Docker show process status (sorted by image name)
alias dkps='docker ps -a | head -n1 ;docker ps -a | tail -n+2 | sort -k2'
# Docker kill all running containers
alias dkk='docker kill $(docker ps -q)'
# Docker remove all stopped containers
alias dkr='docker rm $(docker ps -a -q)'
# Docker remove dangling containers
alias dkd='docker rmi $(docker images --filter "dangling=true" -q --no-trunc)'
# Docker show images
alias dki='docker images'
# Docker show images (sorted by repository name)
alias dkis='docker images | head -n1 ; docker images | tail -n+2 | sort -h -k1'

# Git settings
# Git show status
alias gs='git status'
# Git list branch
alias gb='git branch --all'
# Git fetch remote
alias gf='git fetch --all --verbose'
# Git show graph
alias gg='git log --all --oneline --decorate --graph --color'
# Git show graph pretty
function ggg() {
    local pretty=("%C(auto)%h%C(magenta) %cd %C(yellow)[%cr]%C(auto)%d%n"
                  "%C(auto)%s%n %C(green)Committer:%cN <%cE>%n"
                  "%C(blue)Author :%aN <%aE>%Creset")
    git log --graph --all --date=local --pretty=format:"$pretty"
}
# Git prune local branch
function gu() {
    git fetch -p ; git branch -r \
        | awk '{print $1}' \
        | egrep -v -f /dev/fd/0 <(git branch -vv | grep origin) \
        | awk '{print $1}' | xargs git branch -d
}
# Git pull all remote branches
function gpa() {
    echo "checking all remote branches..."
    git branch -r \
        | grep -v '\->' \
        | sed "s,\x1B\[[0-9;]*[a-zA-Z],,g" \
        | while read remote; do git branch --track "${remote#origin/}" "$remote"; done
    echo "fetching all..."
    git fetch --all
    echo "pulling all..."
    git pull --all
    echo "finished pulling!"
}

# Powerlevel10k settings
[[ -f ~/dotfiles/zsh/p10k.zsh ]] && source ~/dotfiles/zsh/p10k.zsh

# Local settings
# Last, so machine-local values override everything above.
[[ -f ~/.zshlc ]] && source ~/.zshlc
